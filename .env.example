# ── Project Unshell — Environment Variables Reference ─────────────────────────
# Copy this file as needed into each sub-project and fill in your real values.
# NEVER commit the real .env files.

# ── node-backend/.env ─────────────────────────────────────────────────────────
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/unshell?retryWrites=true&w=majority&appName=Cluster0
AI_SERVICE_URL=http://localhost:8001

# ── ai-service/.env ───────────────────────────────────────────────────────────
COMPANIES_HOUSE_API_KEY=your_companies_house_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
NVIDIA_API_KEY=your_nvidia_nim_api_key_here

# ── frontend/.env ─────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000
